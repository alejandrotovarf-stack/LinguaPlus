<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="linguaplus.controlador.DocentesController"
      spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox styleClass="card" prefWidth="320" spacing="10">
        <Label text="Registrar docente" styleClass="section-title"/>

        <Label text="Identificacion" styleClass="field-label"/>
        <TextField fx:id="txtIdentificacion" promptText="Ej. D-03"/>

        <Label text="Nombre" styleClass="field-label"/>
        <TextField fx:id="txtNombre" promptText="Ej. Laura Gomez"/>

        <Label text="Idioma de especialidad" styleClass="field-label"/>
        <TextField fx:id="txtIdioma" promptText="Ej. Ingles"/>

        <Label text="Telefono" styleClass="field-label"/>
        <TextField fx:id="txtTelefono" promptText="Ej. 3201234567"/>

        <Label text="Tarifa por sesion" styleClass="field-label"/>
        <TextField fx:id="txtTarifa" promptText="Ej. 45000"/>

        <Button text="Registrar docente" styleClass="btn-primary" onAction="#onRegistrar" maxWidth="Infinity"/>
        <Label fx:id="lblMensaje" styleClass="helper-text" wrapText="true"/>
    </VBox>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Docentes" styleClass="section-title"/>
        <TableView fx:id="tablaDocentes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIdentificacion" text="Identificacion" prefWidth="110"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="170"/>
                <TableColumn fx:id="colIdioma" text="Idioma" prefWidth="110"/>
                <TableColumn fx:id="colTelefono" text="Telefono" prefWidth="110"/>
                <TableColumn fx:id="colTarifa" text="Tarifa/sesion" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</HBox>
