<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="linguaplus.controlador.EstudiantesController"
      spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox styleClass="card" prefWidth="320" spacing="10">
        <Label text="Registrar estudiante" styleClass="section-title"/>

        <Label text="Nombre completo" styleClass="field-label"/>
        <TextField fx:id="txtNombre" promptText="Ej. Ana Torres"/>

        <Label text="Documento de identidad" styleClass="field-label"/>
        <TextField fx:id="txtDocumento" promptText="Ej. 1001234567"/>

        <Label text="Telefono" styleClass="field-label"/>
        <TextField fx:id="txtTelefono" promptText="Ej. 3001234567"/>

        <Label text="Correo electronico" styleClass="field-label"/>
        <TextField fx:id="txtCorreo" promptText="Ej. ana@correo.com"/>

        <Label text="Edad" styleClass="field-label"/>
        <TextField fx:id="txtEdad" promptText="Ej. 22"/>

        <Button text="Registrar estudiante" styleClass="btn-primary" onAction="#onRegistrar" maxWidth="Infinity"/>
        <Label fx:id="lblMensaje" styleClass="helper-text" wrapText="true"/>
    </VBox>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label text="Estudiantes registrados" styleClass="section-title"/>
        <TableView fx:id="tablaEstudiantes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                <TableColumn fx:id="colDocumento" text="Documento" prefWidth="110"/>
                <TableColumn fx:id="colTelefono" text="Telefono" prefWidth="110"/>
                <TableColumn fx:id="colCorreo" text="Correo" prefWidth="180"/>
                <TableColumn fx:id="colEdad" text="Edad" prefWidth="60"/>
                <TableColumn fx:id="colFechaRegistro" text="Registrado" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</HBox>
